{
  "name": "audio-guardian-functions",
  "version": "1.0.0",
  "description": "Audio Guardian Serverless AI Fraud Detection Backend",
  "main": "lib/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@deepgram/sdk": "^3.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  },
  "private": true
}
