rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGuardian(userId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(userId)/guardians/$(request.auth.uid));
    }

    function guardianHasFullAccess(userId) {
      return isGuardian(userId) &&
        get(/databases/$(database)/documents/users/$(userId)/guardians/$(request.auth.uid)).data.allowFullTranscript == true;
    }

    // Users Collection & Preferences
    match /users/{userId} {
      allow read: if isOwner(userId) || isGuardian(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Linked Family Guardians Subcollection
      match /guardians/{guardianId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == guardianId);
        allow write: if isOwner(userId);
      }
    }

    // Call Records Collection
    match /calls/{callId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || 
        isGuardian(resource.data.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Subcollection for real-time forensic risk events
      match /riskEvents/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.uid == request.auth.uid ||
          isGuardian(get(/databases/$(database)/documents/calls/$(callId)).data.uid)
        );
        allow write: if false; // Real-time risk events emitted strictly by Cloud Functions
      }

      // Subcollection for diarized transcript segments
      match /transcriptSegments/{segmentId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.uid == request.auth.uid ||
          guardianHasFullAccess(get(/databases/$(database)/documents/calls/$(callId)).data.uid)
        );
        allow write: if false;
      }
    }

    // AI Accuracy Verification & User Feedback / RLHF
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.uid);
    }

    // Threat Intelligence & Global Scam Phrases (Read-only for client applications)
    match /scamPhrases/{phraseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Maintained by Admin / Serverless Engine
    }

    // Global Number Reputation Lookup Database
    match /numberReputation/{phone} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated(); // Crowd-sourced reporting
      allow delete: if false;
    }

    // Guardian Alert Emergency Logs
    match /guardianAlerts/{alertId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUid == request.auth.uid || 
        resource.data.guardianUid == request.auth.uid
      );
      allow write: if false; // Generated by serverless notification trigger
    }
  }
}
