# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=audio-guardian-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=audio-guardian-dev
VITE_FIREBASE_STORAGE_BUCKET=audio-guardian-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Backend Cloud Functions API URL (Optional, defaults to mock/local emulation)
VITE_API_BASE_URL=https://us-central1-audio-guardian-dev.cloudfunctions.net

# Demo & Simulation Mode Flag (true enables full offline live simulation without backend required)
VITE_ENABLE_SIMULATION_MODE=true
